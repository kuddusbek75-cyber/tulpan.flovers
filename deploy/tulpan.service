[Unit]
Description=Tulpan Flowers
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/tulpan-django
ExecStart=/var/www/tulpan-django/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 30
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
